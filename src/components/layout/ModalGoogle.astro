  <div id="overlay" class="fixed hidden z-40 w-screen h-screen inset-0 bg-gray-900 bg-opacity-60"></div>

  <!-- The dialog -->
  <div id="dialog"
      class="hidden fixed z-50 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-100 bg-white rounded-md px-8 py-6 space-y-5 drop-shadow-lg">
      <iframe
        id="the-frame"
        class="mi-iframe mb-8"
        src="https://forms.gle/oQtTYP22CQtbokK57"
      >
        Cargando…
      </iframe>
      <footer
      	class="py-3 px-10 flex justify-center items-center absolute bottom-0 w-full z-40 text-gray-800 text-xs font-medium"
      	id="form-footer"
      >
        <nav>
        	<ul class="flex [&>li>a]:inline-block [&>li>a]:px-3 [&>li>a]:py-2">
        	  <li>
              <a 
                role="button" 
                id="close" 
                class="px-5 py-o bg-indigo-500 hover:bg-indigo-700 text-white cursor-pointer rounded-md"
              >
                Cerrar
              </a>
            </li>
        	</ul>
        </nav>
      </footer>
  </div>

  <!-- Javascript code (AD-005: multi-trigger null-safe — desktop #open-modal, menú mobile #open-modal-mobile, hero #open-modal-hero) -->
  <script>
      const dialog = document.getElementById('dialog');
      const closeButton = document.getElementById('close');
      const overlay = document.getElementById('overlay');

      if (dialog && overlay) {
        // show the overlay and the dialog — bind ANY element with [data-open-modal]
        document.querySelectorAll('[data-open-modal]').forEach((trigger) => {
          trigger.addEventListener('click', function (e) {
            e.preventDefault();
            dialog.classList.remove('hidden');
            overlay.classList.remove('hidden');
          });
        });

        // hide the overlay and the dialog
        if (closeButton) {
          closeButton.addEventListener('click', function () {
            dialog.classList.add('hidden');
            overlay.classList.add('hidden');
          });
        }
      }
  </script>

  <style>
      /* CSS general */
.mi-iframe {
width: 50vw;
height: 80vh;
}

