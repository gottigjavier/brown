---
import VideosTab from "./VideosTab.astro";
import Fotos360Tab from "../galeria/Fotos360Tab.astro";
import FotosTab from "../galeria/FotosTab.astro";
---
<div class="tabs ml-6 lg:text-lg">
  <div id="tab-buttons" class="flex justify-center">
    <a href="javascript:void(0)" onclick="changeTab(event, 0)"
      class="inline-block py-3 px-2 text-amber-400 font-semibold border-b-2 border-amber-400 pb-1 mr-0.5">
      <span>Videos</span>
    </a>
    <a href="javascript:void(0)" onclick="changeTab(event, 1)"
      class="inline-block py-3 px-2 text-gray-400 hover:text-gray-200 transition-colors duration-300 pb-1 mr-0.5">
      <span>Fotos 360º</span>
    </a>
    <a href="javascript:void(0)" onclick="changeTab(event, 2)"
      class="inline-block py-3 px-2 text-gray-400 hover:text-gray-200 transition-colors duration-300 pb-1">
      <span>Fotos</span>
    </a>
  </div>

  <!-- Tab Panels -->
  <div id="tab-panels" class="py-0">
    <div>
      <VideosTab />
    </div>

    <div class="hidden">
      <div>
        <Fotos360Tab />
      </div>
    </div>

    <div class="hidden">
      <div>
        <FotosTab />
      </div>
    </div>
  </div>
</div>

<!-- Javascript code -->
<script is:inline>
  function changeTab(event, index) {
    var tabButtons = document.getElementById('tab-buttons').children;
    var tabPanels = document.getElementById('tab-panels').children;

    for (var i = 0; i < tabButtons.length; i++) {
      tabButtons[i].classList.remove('text-amber-400', 'font-semibold', 'border-b-2', 'border-amber-400');
      tabButtons[i].classList.add('text-gray-400', 'hover:text-gray-200');
      tabPanels[i].classList.add('hidden');
    }

    tabButtons[index].classList.remove('text-gray-400', 'hover:text-gray-200');
    tabButtons[index].classList.add('text-amber-400', 'font-semibold', 'border-b-2', 'border-amber-400');
    tabPanels[index].classList.remove('hidden');
  }
</script>

<style>
  .tabs-panels {
    margin: 0;
  }
</style>
