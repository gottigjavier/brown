---
const { color, texto, visib } = Astro.props;
const textColor = `text-${color}`;
---

<div class="bounce">
  <p>
    <b>{texto}</b>
  </p>
</div>

<style>
  .bounce p {
    color: #f1f5f9;
    width: 100%;
    height: 100%;
    line-height: 20px;
    text-align: center;
    transform: translateX(0);
    animation: marquesina 8s cubic-bezier(0.16, 1, 0.3, 1) infinite alternate;
    will-change: transform;
  }

  @keyframes marquesina {
    0% {
      transform: translateX(-5%);
    }
    100% {
      transform: translateX(5%);
    }
  }
</style>
