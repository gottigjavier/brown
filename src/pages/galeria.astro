<!-- Stub de redirección (AD-003): /galeria → /#galeria
Deno Deploy file_server no expone reglas de redirect ni _redirects;
el meta refresh es el mecanismo universal de hosts estáticos.
El fragment scrollea al ancla porque la landing es HTML server-rendered. -->
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="0; url=/#galeria" />
    <link rel="canonical" href="/#galeria" />
    <title>Dron Video 360</title>
  </head>
  <body>
    <p style="font-family: system-ui, sans-serif; text-align: center; margin-top: 2rem">
      <a href="/#galeria">Ir a la galería</a>
    </p>
  </body>
</html>
