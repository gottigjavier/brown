---
import Header from "../components/layout/Header.astro";
import FooterMenu from "../components/layout/FooterMenu.astro";
import ModalGoogle from "../components/layout/ModalGoogle.astro";

export interface Props {
  title: string
}

const { title } = Astro.props

// Anclas de navegación de la landing (AD-006 / NAV-001 — labels a confirmar con copy, task 4.1)
const DEFAULT_ANCHORS = [
  { href: '/#speech', label: 'Speech' },
  { href: '/#galeria', label: 'Galería' },
  { href: '/#trabajos', label: 'Trabajos' },
];
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-L7KJ73SQHP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-L7KJ73SQHP");
    </script>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/icons/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- 
    <script is:inline src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
     -->

    <!-- for optimal display on high DPI devices -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Single meta description (RUT-005 / AC-RUT-010) -->
    <meta name="description" content="DRON VIDEO 360 — Fotografía y video 360° con drones para turismo, hotelería y empresas." />

    <script type="importmap">
      {
        "imports": {
          "three": "/js/three.js",
          "@photo-sphere-viewer/core": "/js/core.js",
          "@photo-sphere-viewer/autorotate-plugin": "/js/autorotate.js"
        }
      }
    </script>

    <link
      rel="stylesheet"
      href="/css/photo-sphere.css"
    />
  </head>
  <body>
    <Header variant="default" links={DEFAULT_ANCHORS} />
    <main>
      <slot />
    </main>
    <FooterMenu />
    <!-- ENM-001: ModalGoogle montado UNA vez en el shell → los triggers [data-open-modal]
         (header desktop/mobile, 7º ícono Redes, footer Contacto) funcionan en TODAS las
         páginas (/, /legales, 404). Ya NO se monta en index.astro. -->
    <ModalGoogle />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --color-accent: #fbbf24;
    --color-accent-hover: #f59e0b;
    --color-surface: #0a0a0f;
    --color-surface-card: #1a1a24;
    --color-surface-elevated: #252533;
    --color-text-primary: #f1f5f9;
    --color-text-secondary: #94a3b8;
    --color-text-muted: #64748b;
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 8px 30px rgba(0, 0, 0, 0.5);
    --transition-base: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    /* Altura real del header fijo (logo 70px + py-3) + margen (AC-NAV-003) */
    --header-offset: 120px;
  }
    @font-face {
    font-family: "Gotham SSm A";
    src: url("/fonts/gotham-300.woff2") format("woff2");
    font-weight: 300;
    font-style: normal;
  }
  @font-face {
    font-family: "Gotham SSm A";
    src: url("/fonts/gotham-400.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: "Gotham SSm A";
    src: url("/fonts/gotham-500.woff2") format("woff2");
    font-weight: 500;
    font-style: normal;
  }
  @font-face {
    font-family: "Gotham SSm A";
    src: url("/fonts/gotham-700.woff2") format("woff2");
    font-weight: 700;
    font-style: normal;
  }

  /* Custom scrollbar para modo oscuro */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  /* Selection color */
  ::selection {
    background: var(--color-accent);
    color: #0a0a0f;
  }

  /* Anclas: compensar el header fijo al scrollear a una sección (AC-NAV-003 / AD-006) */
  section[id] {
    scroll-margin-top: var(--header-offset);
  }
</style>
